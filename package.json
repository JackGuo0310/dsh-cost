{
  "name": "dsh-cost",
  "version": "0.1.0",
  "description": "Per-turn and per-session API cost estimate for DeepSeek Harness conversations. · DSH 对话费用插件：每轮显示本轮花费与会话累计花费。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "check": "node --check client/client.js && node --check lib/index.js",
    "test": "node test/client.test.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cost",
    "pricing",
    "usage",
    "tokens"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "react": "^18.3.1",
    "react-test-renderer": "^18.3.1"
  }
}
