{
  "name": "@jackguo0310/dsh-cost",
  "version": "0.1.1",
  "description": "Per-turn and per-session API cost estimation for DeepSeek Harness conversations.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "check": "node --check client/client.js && node --check lib/index.js",
    "test": "node test/client.test.mjs",
    "prepublishOnly": "npm run check && npm test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "harness",
    "cost",
    "pricing",
    "usage",
    "tokens"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackGuo0310/dsh-cost.git"
  },
  "homepage": "https://github.com/JackGuo0310/dsh-cost#readme",
  "bugs": {
    "url": "https://github.com/JackGuo0310/dsh-cost/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "react": "^18.3.1",
    "react-test-renderer": "^18.3.1"
  }
}
